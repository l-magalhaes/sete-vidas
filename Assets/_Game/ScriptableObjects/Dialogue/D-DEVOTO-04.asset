  IsDocument: 0
  Lines:
  - Speaker: {fileID: 0}
    Expression: 
    Text: "Uma p\xE1gina rasgada: \"Subimos ao ninho com a oferenda, como manda o costume.\""
  - Speaker: {fileID: 0}
    Expression: 
    Text: "\"Ela abriu os olhos. N\xE3o eram os olhos dela. Eram verdes.\""
  - Speaker: {fileID: 0}
    Expression: 
    Text: "\"Corremos. O anci\xE3o ficou.\""
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: 
    Text: "...O anci\xE3o ficou."
