  IsDocument: 0
  Lines:
  - Speaker: {fileID: 0}
    Expression: 
    Text: "Classe Ca\xE7ador desbloqueada! +1 cora\xE7\xE3o. Pressione {trocar_classe} para alternar entre as classes."
  - Speaker: {fileID: 0}
    Expression: 
    Text: "Ca\xE7ador: pressione {atacar} para disparar flechas. Use {subir} + {atacar} para atirar para cima."
  - Speaker: {fileID: 0}
    Expression: 
    Text: "Nova habilidade permanente: pressione {dash} para realizar um avan\xE7o r\xE1pido no ch\xE3o ou no ar."
  - Speaker: {fileID: 0}
    Expression: 
    Text: 'Nova habilidade permanente: pressione {especial} para disparar a flecha com corda em ganchos.'
