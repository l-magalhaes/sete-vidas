  m_Script: {fileID: 11500000, guid: 7a542215b885b59408cc6d453acb5cd7, type: 3}
  m_Name: D-TOBI-06
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: D-TOBI-06
  Required: 0
  Revision: 1
  IsDocument: 0
  Lines:
  - Speaker: {fileID: 11400000, guid: b40b090f64e63df46b30616fbb59372e, type: 2}
    Expression: animada
    Text: "Ah! Antes que eu me esque\xE7a, gato!"
  - Speaker: {fileID: 11400000, guid: b40b090f64e63df46b30616fbb59372e, type: 2}
    Expression: orgulhosa
    Text: "Eu tenho uma lojinha em Miarav\xE9u. Ferramentas, consertos, bugigangas de primeira. Tudo feito por estas m\xE3os!"
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: ironico
    Text: "Deixa eu adivinhar. Nada de gra\xE7a."
  - Speaker: {fileID: 11400000, guid: b40b090f64e63df46b30616fbb59372e, type: 2}
    Expression: gananciosa
    Text: "De gra\xE7a, s\xF3 o conselho. Mas para quem cai de ponte, eu fa\xE7o um precinho especial."
  - Speaker: {fileID: 11400000, guid: b40b090f64e63df46b30616fbb59372e, type: 2}
    Expression: animada
    Text: "Quando chegar na cidade, passa l\xE1! Procura a placa com uma chave inglesa. A maior da rua, claro."
