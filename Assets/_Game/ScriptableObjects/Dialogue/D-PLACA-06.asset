  ScriptId: D-PLACA-06
  Required: 0
  Revision: 1
  IsDocument: 0
  Lines:
  - Speaker: {fileID: 0}
    Expression: 
    Text: "Di\xE1rio do Guardi\xE3o do Selo: o tomo voltou a sussurrar \xE0 noite. Pedi refor\xE7os."
  - Speaker: {fileID: 0}
    Expression: 
    Text: "A resposta de Soluki chegou hoje. Uma palavra: \"Supersti\xE7\xE3o.\""
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: 
    Text: "...O c\xE3o de lata avisou. Ningu\xE9m ouviu."
