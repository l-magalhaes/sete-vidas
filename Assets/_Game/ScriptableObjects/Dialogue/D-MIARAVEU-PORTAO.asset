  m_Name: D-MIARAVEU-PORTAO
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: D-MIARAVEU-PORTAO
  Required: 1
  Revision: 1
  IsDocument: 0
  Lines:
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: ironico
    Text: "\"Bem-vindo a Miarav\xE9u.\" A placa ainda acredita nisso."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: serio
    Text: "Ningu\xE9m conserta este port\xE3o faz tempo. Do que ser\xE1 que a cidade estava se protegendo?"
  - Speaker: {fileID: 0}
    Expression: 
    Text: "Fim da Floresta Silenciosa. A estrada para Miarav\xE9u continua... em breve."
