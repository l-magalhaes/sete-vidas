  m_Script: {fileID: 11500000, guid: 7a542215b885b59408cc6d453acb5cd7, type: 3}
  m_Name: D-VULPIS-VINCULO-b
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: D-VULPIS-VINCULO-b
  Required: 1
  Revision: 1
  IsDocument: 0
  Lines:
  - Speaker: {fileID: 11400000, guid: 15de09afa34ec1a46bee5989f0455dcb, type: 2}
    Expression: 
    Text: "Mas voc\xEA pode. Leve isto: meu arco, e uma flecha com corda. Prende em gancho, puxa voc\xEA at\xE9 l\xE1."
  - Speaker: {fileID: 11400000, guid: 15de09afa34ec1a46bee5989f0455dcb, type: 2}
    Expression: 
    Text: "E aprenda a avan\xE7ar como raposa: um salto r\xE1pido, rente, que vence o v\xE3o que o pulo n\xE3o vence."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: ironico
    Text: Arco, corda e um curso de raposa. Quanto eu devo?
  - Speaker: {fileID: 11400000, guid: 15de09afa34ec1a46bee5989f0455dcb, type: 2}
    Expression: 
    Text: "Uma floresta viva. E a chave. V\xE1 antes que eu me arrependa."
