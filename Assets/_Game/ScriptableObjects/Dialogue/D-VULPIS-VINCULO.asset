MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a542215b885b59408cc6d453acb5cd7, type: 3}
  m_Name: D-VULPIS-VINCULO
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: D-VULPIS-VINCULO
  Required: 1
  Revision: 1
  IsDocument: 0
  Lines:
  - Speaker: {fileID: 11400000, guid: 15de09afa34ec1a46bee5989f0455dcb, type: 2}
    Expression: 
    Text: "Desde as ra\xEDzes eu sigo voc\xEA. Um gato que cai de pontes n\xE3o passa despercebido."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: ironico
    Text: Seguindo um gato pela floresta. Isso tem nome, sabia?
  - Speaker: {fileID: 11400000, guid: 15de09afa34ec1a46bee5989f0455dcb, type: 2}
    Expression: 
    Text: "Vigiar. Eu vigio esta floresta. E ela est\xE1 morrendo."
  - Speaker: {fileID: 11400000, guid: 15de09afa34ec1a46bee5989f0455dcb, type: 2}
    Expression: 
    Text: "A praga chegou na Isyathy, a guardi\xE3. Uma serpente mais velha que as \xE1rvores."
  - Speaker: {fileID: 11400000, guid: 15de09afa34ec1a46bee5989f0455dcb, type: 2}
    Expression: 
    Text: "Ela dorme enrolada no alto do vale, e a doen\xE7a dela corre pelas ra\xEDzes. Cada planta torta, cada bicho de olho verde... \xE9 ela."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: 
    Text: E o caminho para a ponte passa por ela. Claro que passa.
  - Speaker: {fileID: 11400000, guid: 15de09afa34ec1a46bee5989f0455dcb, type: 2}
    Expression: 
    Text: "Passa pelo Templo da Serpente, no Mirante. Fechado. A chave se perdeu h\xE1 muitos anos, nas ru\xEDnas atr\xE1s deste posto."
  - Speaker: {fileID: 11400000, guid: 15de09afa34ec1a46bee5989f0455dcb, type: 2}
    Expression: 
    Text: "Eu n\xE3o posso ir. Se eu tirar os olhos do ninho, ningu\xE9m avisa quando ela acordar."
