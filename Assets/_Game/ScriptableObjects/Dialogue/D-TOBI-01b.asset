  m_Script: {fileID: 11500000, guid: 7a542215b885b59408cc6d453acb5cd7, type: 3}
  m_Name: D-TOBI-01b
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: D-TOBI-01b
  Required: 1
  Revision: 1
  IsDocument: 0
  Lines:
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: ironico
    Text: "Eu j\xE1 estou do lado certo. Para que eu quero ponte?"
  - Speaker: {fileID: 11400000, guid: b40b090f64e63df46b30616fbb59372e, type: 2}
    Expression: orgulhosa
    Text: "Para voltar sem cair, para come\xE7ar! E quem sabe o que tem do outro lado daqui a umas luas? Uma ponte \xE9 um caminho para sempre."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: ironico
    Text: "Eu ca\xED dessa ponte. Devia ganhar desconto."
  - Speaker: {fileID: 11400000, guid: b40b090f64e63df46b30616fbb59372e, type: 2}
    Expression: ofendida
    Text: "Desconto \xE9 para quem cai de p\xE9. Ah... voc\xEA caiu de p\xE9? Bom, n\xE3o muda nada."
