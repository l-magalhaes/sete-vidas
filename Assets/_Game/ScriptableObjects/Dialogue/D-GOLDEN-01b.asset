  m_Script: {fileID: 11500000, guid: 7a542215b885b59408cc6d453acb5cd7, type: 3}
  m_Name: D-GOLDEN-01b
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: D-GOLDEN-01b
  Required: 1
  Revision: 2
  IsDocument: 0
  Lines:
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: 
    Text: Destruir o tomo... tanto faz. Eu quero a capivara.
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: 
    Text: "Ningu\xE9m me usa como chave e me paga com troco. Ningu\xE9m."
  - Speaker: {fileID: 11400000, guid: 13fde793bf1ab1249b81bd2fbc88a640, type: 2}
    Expression: serio
    Text: "Vingan\xE7a \xE9 um come\xE7o ruim. Mas \xE9 um come\xE7o. Jure, e levante."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: 
    Text: Eu juro. Pelo tomo, pela moeda... e pelas seis vidas que ele me tirou.
