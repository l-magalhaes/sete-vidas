MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a542215b885b59408cc6d453acb5cd7, type: 3}
  m_Name: D-GOLDEN-01
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: D-GOLDEN-01
  Required: 1
  Revision: 6
  IsDocument: 0
  Lines:
  - Speaker: {fileID: 11400000, guid: 13fde793bf1ab1249b81bd2fbc88a640, type: 2}
    Expression: ferido
    Text: "Ladr\xE3ozinho! Aguente firme. Seu \xFAltimo cora\xE7\xE3o ainda bate... por pouco."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: ironico
    Text: "\xD3timo. Agora o c\xE3o de lata vai me dar serm\xE3o antes de eu morrer."
  - Speaker: {fileID: 11400000, guid: 13fde793bf1ab1249b81bd2fbc88a640, type: 2}
    Expression: 
    Text: "Serm\xE3o nenhum. Quem fez isso? Quem levou o tomo?"
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: 
    Text: "O contratante. Uma capivara. Me pagou com uma moeda... e com seis vidas."
  - Speaker: {fileID: 11400000, guid: 13fde793bf1ab1249b81bd2fbc88a640, type: 2}
    Expression: ferido
    Text: "Gastei minha \xFAltima for\xE7a segurando a praga do livro. Contive pouco; ela j\xE1 se espalha."
  - Speaker: {fileID: 11400000, guid: 13fde793bf1ab1249b81bd2fbc88a640, type: 2}
    Expression: serio
    Text: "Preciso descansar. Jure me ajudar a recuperar o tomo e destru\xED-lo, e minha for\xE7a \xE9 sua."
