  m_Script: {fileID: 11500000, guid: 7a542215b885b59408cc6d453acb5cd7, type: 3}
  m_Name: D-GOLDEN-01
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: D-GOLDEN-01
  Required: 1
  Revision: 2
  Lines:
  - Speaker: {fileID: 11400000, guid: 13fde793bf1ab1249b81bd2fbc88a640, type: 2}
    Expression: 
    Text: "Respire, ladr\xE3ozinho. Seu \xFAltimo cora\xE7\xE3o ainda bate... por pouco."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: ironico
    Text: "Voc\xEA... me salvou? Depois da surra que eu te dei?"
  - Speaker: {fileID: 11400000, guid: 13fde793bf1ab1249b81bd2fbc88a640, type: 2}
    Expression: 
    Text: "Quem aguenta o selo e ainda respira \xE9 forte. For\xE7a assim n\xE3o se desperdi\xE7a."
  - Speaker: {fileID: 11400000, guid: 13fde793bf1ab1249b81bd2fbc88a640, type: 2}
    Expression: 
    Text: "Jure destruir esse tomo. Em troca, minha for\xE7a \xE9 sua."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: 
    Text: "Juro. N\xE3o que eu tenha muita escolha."
