  m_Name: P-PRIM-10
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: P-PRIM-10
  Required: 0
  Revision: 1
  IsDocument: 0
  Lines:
  - Speaker: {fileID: 0}
    Expression: 
    Text: "Um balc\xE3o com uma esteira parada e uma gaveta de metal aberta."
  - Speaker: {fileID: 0}
    Expression: 
    Text: "Dentro, discos finos e pap\xE9is coloridos, colados um no outro pelo mofo."
  - Speaker: {fileID: 0}
    Expression: 
    Text: Ao lado, gaiolas de arame com rodinhas, encaixadas umas nas outras.
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: ironico
    Text: "Pagavam para levar a comida que j\xE1 estava ali. E ainda empurravam uma gaiola."
