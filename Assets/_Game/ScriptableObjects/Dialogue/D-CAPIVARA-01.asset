  m_Script: {fileID: 11500000, guid: 7a542215b885b59408cc6d453acb5cd7, type: 3}
  m_Name: D-CAPIVARA-01
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: D-CAPIVARA-01
  Required: 1
  Revision: 1
  Lines:
  - Speaker: {fileID: 11400000, guid: 0aa0ea6dc3ac1df4db4f50e17bf70cd2, type: 2}
    Expression: 
    Text: "Ah, estava sim. Nas letras mi\xFAdas. Que voc\xEA, claro, n\xE3o leu."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: 
    Text: "Voc\xEA... o contratante. O que voc\xEA fez comigo?"
  - Speaker: {fileID: 11400000, guid: 0aa0ea6dc3ac1df4db4f50e17bf70cd2, type: 2}
    Expression: 
    Text: "Eu? Nada. O tomo dorme h\xE1 cem anos e s\xF3 acorda bebendo vidas."
  - Speaker: {fileID: 11400000, guid: 0aa0ea6dc3ac1df4db4f50e17bf70cd2, type: 2}
    Expression: 
    Text: Sete vidas de gato. Raras. Deliciosas. Exatamente o que ele precisava.
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: 
    Text: "Voc\xEA me usou... desde o come\xE7o."
  - Speaker: {fileID: 11400000, guid: 0aa0ea6dc3ac1df4db4f50e17bf70cd2, type: 2}
    Expression: 
    Text: "Como se usa uma chave, gatinho. E chaves n\xE3o reclamam da porta."
