  m_Script: {fileID: 11500000, guid: 7a542215b885b59408cc6d453acb5cd7, type: 3}
  m_Name: D-TOMO-01
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: D-TOMO-01
  Required: 1
  Revision: 2
  Lines:
  - Speaker: {fileID: 0}
    Expression: 
    Text: "O tomo \xE9 pesado e frio. As runas acendem sob as suas patas."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: 
    Text: "...Ele est\xE1 me olhando?"
  - Speaker: {fileID: 0}
    Expression: 
    Text: "O selo se rompe com um estalo seco. Algo puxa o ar dos seus pulm\xF5es."
