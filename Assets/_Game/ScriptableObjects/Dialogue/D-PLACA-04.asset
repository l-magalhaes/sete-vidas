  m_Script: {fileID: 11500000, guid: 7a542215b885b59408cc6d453acb5cd7, type: 3}
  m_Name: D-PLACA-04
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: D-PLACA-04
  Required: 0
  Revision: 1
  Lines:
  - Speaker: {fileID: 0}
    Expression: 
    Text: "C\xE2mara do Selo. H\xE1 cem anos a Ordem prendeu aqui um tomo que bebe vidas."
  - Speaker: {fileID: 0}
    Expression: 
    Text: "Que ningu\xE9m o desperte. Que nenhum guardi\xE3o o abandone."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: 
    Text: "...Ningu\xE9m falou nada de beber vidas."
