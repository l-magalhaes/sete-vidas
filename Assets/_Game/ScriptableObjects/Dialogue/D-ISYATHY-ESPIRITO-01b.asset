  m_Script: {fileID: 11500000, guid: 7a542215b885b59408cc6d453acb5cd7, type: 3}
  m_Name: D-ISYATHY-ESPIRITO-01b
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.Dialogue.DialogueDefinition
  ScriptId: D-ISYATHY-ESPIRITO-01b
  Required: 1
  Revision: 1
  IsDocument: 0
  Lines:
  - Speaker: {fileID: 11400000, guid: 8a4c4debdeaeb30479394b993da45b8b, type: 2}
    Expression: 
    Text: "A doen\xE7a saiu do livro que voc\xEA carregou, pequeno. Eu senti quando ele acordou."
  - Speaker: {fileID: 11400000, guid: 8a4c4debdeaeb30479394b993da45b8b, type: 2}
    Expression: 
    Text: "Mas o livro n\xE3o nasceu entre os c\xE3es. A maldi\xE7\xE3o e o livro v\xEAm de longe, de uma torre que fura as nuvens."
  - Speaker: {fileID: 11400000, guid: 8a4c4debdeaeb30479394b993da45b8b, type: 2}
    Expression: 
    Text: "E a doen\xE7a n\xE3o vai parar nas minhas ra\xEDzes."
  - Speaker: {fileID: 11400000, guid: 65348136a88ff0541a9211e41a8d418e, type: 2}
    Expression: serio
    Text: A torre do horizonte. Aetherion.
  - Speaker: {fileID: 11400000, guid: 8a4c4debdeaeb30479394b993da45b8b, type: 2}
    Expression: 
    Text: "V\xE1, pequeno que cai. Eu continuo aqui. Quando passar pela floresta, procure os meus olhos."
