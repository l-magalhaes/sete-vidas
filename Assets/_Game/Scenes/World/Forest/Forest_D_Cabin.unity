  m_Script: {fileID: 11500000, guid: 2df9553fa56d6684c8b6e932ef7ace0c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: SeteVidas.Runtime::SeteVidas.World.SceneBark
  key: cabana_vulpis_vazia
  lines:
  - "Vazia. Mas a lareira est\xE1 acesa."
  - Arco na parede, flechas no barril, uma pele secando...
  - "Algum ca\xE7ador mora aqui. E saiu faz pouco."
  delay: 0.8
  secondsPerLine: 2.6
  afterFlag: vinculo_vulpis
  afterLines:
  - "Arco na parede, mapa da floresta, a trilha at\xE9 o ninho..."
  - Deve ser a casa daquela raposa.
  - "Ela n\xE3o vai sentir falta de umas moedas. N\xE9?"
